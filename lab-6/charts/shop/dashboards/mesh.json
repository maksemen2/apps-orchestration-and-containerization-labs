{
  "uid": "lab6-mesh",
  "title": "Lab 6 Shop mesh",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "shop",
    "lab-6",
    "linkerd"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "textbox",
        "query": "shop",
        "current": {
          "text": "shop",
          "value": "shop"
        }
      },
      {
        "name": "release",
        "label": "Release",
        "type": "textbox",
        "query": "shop",
        "current": {
          "text": "shop",
          "value": "shop"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Linkerd inbound traffic by API version",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (version) (rate(response_total{namespace=\"$namespace\",direction=\"inbound\",target_port=\"8080\",tls=\"true\",route_name=\"default\",version=~\"v1|v2\"}[$__rate_interval]))",
          "legendFormat": "{{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Backend and final client 5xx ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum by (version) (rate(response_total{namespace=\"$namespace\",direction=\"inbound\",target_port=\"8080\",tls=\"true\",route_name=\"default\",version=~\"v1|v2\",status_code=~\"5..\"}[$__rate_interval])) or (0 * sum by (version) (rate(response_total{namespace=\"$namespace\",direction=\"inbound\",target_port=\"8080\",tls=\"true\",route_name=\"default\",version=~\"v1|v2\"}[$__rate_interval])))) / clamp_min(sum by (version) (rate(response_total{namespace=\"$namespace\",direction=\"inbound\",target_port=\"8080\",tls=\"true\",route_name=\"default\",version=~\"v1|v2\"}[$__rate_interval])), 0.001)",
          "legendFormat": "backend {{version}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "100 * (sum(rate(outbound_http_route_request_statuses_total{namespace=\"$namespace\",parent_name=\"$release-api\",pod=~\"$release-load-.*\",http_status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(outbound_http_route_request_statuses_total{namespace=\"$namespace\",parent_name=\"$release-api\",pod=~\"$release-load-.*\"}[$__rate_interval])), 0.001)",
          "legendFormat": "final client",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Linkerd inbound p95 latency by API version",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (version, le) (rate(response_latency_ms_bucket{namespace=\"$namespace\",direction=\"inbound\",target_port=\"8080\",tls=\"true\",route_name=\"default\",version=~\"v1|v2\"}[$__rate_interval]))) / 1000",
          "legendFormat": "{{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Linkerd outbound retries",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(outbound_http_route_retry_requests_total{namespace=\"$namespace\",parent_name=\"$release-api\",pod=~\"$release-load-.*\"}[$__rate_interval]))",
          "legendFormat": "retries",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "CPU: application and proxy",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",pod=~\"$release-api.*\",container=~\"api|linkerd-proxy\"}[$__rate_interval]))",
          "legendFormat": "{{container}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Memory: application and proxy",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (container_memory_working_set_bytes{namespace=\"$namespace\",pod=~\"$release-api.*\",container=~\"api|linkerd-proxy\"})",
          "legendFormat": "{{container}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Authenticated API requests by client identity",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (client_id) (rate(response_total{namespace=\"$namespace\",direction=\"inbound\",target_port=\"8080\",tls=\"true\",route_name=\"default\"}[$__rate_interval]))",
          "legendFormat": "{{client_id}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Traffic share by API version",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (version) (rate(response_total{namespace=\"$namespace\",direction=\"inbound\",target_port=\"8080\",tls=\"true\",route_name=\"default\",version=~\"v1|v2\"}[$__rate_interval])) / scalar(clamp_min(sum(rate(response_total{namespace=\"$namespace\",direction=\"inbound\",target_port=\"8080\",tls=\"true\",route_name=\"default\",version=~\"v1|v2\"}[$__rate_interval])), 0.001))",
          "legendFormat": "{{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    }
  ]
}
